    {
      "type": "BuiltinCommonInstructions::JsCode",
      "inlineCode": [
        "gdjs.AutoBuilder = gdjs.AutoBuilder || {};",
        "var AB = gdjs.AutoBuilder;",
        "",
        "if (!AB._initialized) {",
        "  AB._initialized = true;",
        "  AB.currentLevel = 1;",
        "  AB.totalLevels = 0;",
        "  AB.score = 0;",
        "  AB.solvedSlots = [];",
        "  AB.levelSolved = false;",
        "  AB.solvedTimer = 0;",
        "  AB.gameComplete = false;",
        "  AB.scripturesData = null;",
        "  AB.slotXs = [];",
        "  AB.wallXs = [];",
        "  AB.groundY = 0;",
        "  AB.levelTimeLimit = 0;",
        "  AB.levelTimeRemaining = 0;",
        "  AB.flashRemaining = 0;",
        "  AB.flashColor = null;",
        "  AB.ambientColor = { r: 100, g: 180, b: 240 };",
        "  AB.shakeRemaining = 0;",
        "  AB.windTimer = 0;",
        "  AB._prevMouseDown = false;",
        "  AB.audioCtx = null;",
        "",
        "  AB.ambientPalette = [",
        "    { r: 100, g: 180, b: 240 },",
        "    { r: 160, g: 200, b: 140 },",
        "    { r: 240, g: 190, b: 120 },",
        "    { r: 210, g: 150, b: 210 },",
        "    { r: 255, g: 215, b: 120 }",
        "  ];",
        "",
        "  AB.getAudioContext = function () {",
        "    if (!AB.audioCtx) {",
        "      try {",
        "        var Ctor = window.AudioContext || window.webkitAudioContext;",
        "        AB.audioCtx = new Ctor();",
        "      } catch (e) {",
        "        AB.audioCtx = null;",
        "      }",
        "    }",
        "    if (AB.audioCtx && AB.audioCtx.state === \"suspended\") {",
        "      AB.audioCtx.resume();",
        "    }",
        "    return AB.audioCtx;",
        "  };",
        "",
        "  AB.playTone = function (frequency, duration, type, startDelay) {",
        "    var ctx = AB.getAudioContext();",
        "    if (!ctx) {",
        "      return;",
        "    }",
        "    try {",
        "      var osc = ctx.createOscillator();",
        "      var gain = ctx.createGain();",
        "      osc.type = type || \"sine\";",
        "      osc.frequency.value = frequency;",
        "      var startTime = ctx.currentTime + (startDelay || 0);",
        "      gain.gain.setValueAtTime(0.0001, startTime);",
        "      gain.gain.exponentialRampToValueAtTime(0.25, startTime + 0.02);",
        "      gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);",
        "      osc.connect(gain);",
        "      gain.connect(ctx.destination);",
        "      osc.start(startTime);",
        "      osc.stop(startTime + duration + 0.05);",
        "    } catch (e) {",
        "      // Audio is best-effort; a failure here must not break gameplay.",
        "    }",
        "  };",
        "",
        "  AB.playCorrectPop = function () {",
        "    AB.playTone(880, 0.12, \"triangle\", 0);",
        "  };",
        "",
        "  AB.playLevelComplete = function () {",
        "    AB.playTone(523.25, 0.15, \"triangle\", 0);",
        "    AB.playTone(659.25, 0.15, \"triangle\", 0.12);",
        "    AB.playTone(783.99, 0.25, \"triangle\", 0.24);",
        "  };",
        "",
        "  AB.playGameComplete = function () {",
        "    AB.playTone(523.25, 0.18, \"triangle\", 0);",
        "    AB.playTone(659.25, 0.18, \"triangle\", 0.16);",
        "    AB.playTone(783.99, 0.18, \"triangle\", 0.32);",
        "    AB.playTone(1046.5, 0.4, \"triangle\", 0.48);",
        "  };",
        "",
        "  AB.playTimeWarning = function () {",
        "    AB.playTone(220, 0.1, \"square\", 0);",
        "  };",
        "",
        "  AB.flash = function (r, g, b, durationMs) {",
        "    AB.flashColor = { r: r, g: g, b: b };",
        "    AB.flashRemaining = durationMs;",
        "  };",
        "",
        "  AB.shake = function (durationMs) {",
        "    AB.shakeRemaining = durationMs;",
        "  };",
        "",
        "  AB.clearLevelObjects = function (runtimeScene) {",
        "    [\"WallFoundation\", \"StoneBlock\", \"VerseTile\"].forEach(function (name) {",
        "      runtimeScene.getObjects(name).slice().forEach(function (obj) {",
        "        obj.deleteFromScene(runtimeScene);",
        "      });",
        "    });",
        "  };",
        "",
        "  AB.updateHud = function (runtimeScene) {",
        "    var hud = runtimeScene.getObjects(\"HUDText\")[0];",
        "    if (hud) {",
        "      var seconds = Math.max(0, Math.ceil(AB.levelTimeRemaining));",
        "      hud.setString(",
        "        \"Level \" + AB.currentLevel + \" / \" + AB.totalLevels +",
        "          \"   Score: \" + AB.score +",
        "          \"   Time: \" + seconds",
        "      );",
        "    }",
        "  };",
        "",
        "  AB.resetGame = function (runtimeScene) {",
        "    AB.currentLevel = 1;",
        "    AB.score = 0;",
        "    AB.gameComplete = false;",
        "    AB.startLevel(runtimeScene, AB.currentLevel);",
        "  };",
        "",
        "  AB.startLevel = function (runtimeScene, levelNumber) {",
        "    AB.clearLevelObjects(runtimeScene);",
        "    AB.levelSolved = false;",
        "    AB.solvedTimer = 0;",
        "",
        "    var levelData = AB.scripturesData.levels.filter(function (level) {",
        "      return level.levelId === levelNumber;",
        "    })[0];",
        "",
        "    if (!levelData) {",
        "      AB.gameComplete = true;",
        "      AB.playGameComplete();",
        "      AB.flash(255, 255, 255, 400);",
        "      var hud = runtimeScene.getObjects(\"HUDText\")[0];",
        "      if (hud) {",
        "        hud.setString(",
        "          \"The wall is finished! Final score: \" + AB.score + \"   (tap to play again)\"",
        "        );",
        "      }",
        "      return;",
        "    }",
        "",
        "    var ambient = AB.ambientPalette[(levelNumber - 1) % AB.ambientPalette.length];",
        "    AB.ambientColor = ambient;",
        "    runtimeScene.setBackgroundColor(ambient.r, ambient.g, ambient.b);",
        "",
        "    var gameWidth = runtimeScene.getGame().getGameResolutionWidth();",
        "    var gameHeight = runtimeScene.getGame().getGameResolutionHeight();",
        "    var groundY = gameHeight - 80;",
        "    AB.groundY = groundY;",
        "",
        "    var foundation = runtimeScene.createObject(\"WallFoundation\");",
        "    if (foundation) {",
        "      foundation.setPosition(0, groundY);",
        "      foundation.setWidth(gameWidth);",
        "      foundation.setHeight(80);",
        "    }",
        "",
        "    var tokens = levelData.puzzleWords || [];",
        "    var count = tokens.length;",
        "    var margin = gameWidth * 0.08;",
        "    var usableWidth = gameWidth - margin * 2;",
        "    var step = count > 1 ? usableWidth / (count - 1) : 0;",
        "",
        "    AB.slotXs = [];",
        "    AB.wallXs = [];",
        "    for (var s = 0; s < count; s++) {",
        "      var x = count > 1 ? margin + step * s : gameWidth / 2;",
        "      AB.slotXs.push(x);",
        "      AB.wallXs.push(x);",
        "    }",
        "",
        "    AB.solvedSlots = tokens.map(function () {",
        "      return false;",
        "    });",
        "",
        "    var wallSpawnY = 60;",
        "    for (var w = 0; w < count; w++) {",
        "      var block = runtimeScene.createObject(\"StoneBlock\");",
        "      if (block) {",
        "        block.setPosition(AB.wallXs[w] - 70, wallSpawnY);",
        "        block.setOpacity(110);",
        "      }",
        "    }",
        "",
        "    var shuffled = tokens.slice();",
        "    for (var j = shuffled.length - 1; j > 0; j--) {",
        "      var k = Math.floor(Math.random() * (j + 1));",
        "      var temp = shuffled[j];",
        "      shuffled[j] = shuffled[k];",
        "      shuffled[k] = temp;",
        "    }",
        "",
        "    var tileRowY = groundY + 40;",
        "    shuffled.forEach(function (token, slotIndex) {",
        "      var tile = runtimeScene.createObject(\"VerseTile\");",
        "      if (!tile) {",
        "        return;",
        "      }",
        "      tile.setPosition(AB.slotXs[slotIndex], tileRowY);",
        "      tile.setString(token.text);",
        "      var correctSlot = tokens.indexOf(token);",
        "      tile.getVariables().get(\"TileID\").setNumber(correctSlot + 1);",
        "      tile.getVariables().get(\"CurrentSlot\").setNumber(slotIndex);",
        "    });",
        "",
        "    AB.levelTimeLimit = 20 + count * 6;",
        "    AB.levelTimeRemaining = AB.levelTimeLimit;",
        "    AB.windTimer = 0;",
        "",
        "    AB.updateHud(runtimeScene);",
        "  };",
        "",
        "  AB.lockBlock = function (runtimeScene, slotIndex) {",
        "    var blocks = runtimeScene.getObjects(\"StoneBlock\");",
        "    var targetX = AB.wallXs[slotIndex] - 70;",
        "    var best = null;",
        "    var bestDist = Infinity;",
        "    blocks.forEach(function (block) {",
        "      var dist = Math.abs(block.getX() - targetX);",
        "      if (dist < bestDist) {",
        "        bestDist = dist;",
        "        best = block;",
        "      }",
        "    });",
        "    if (best) {",
        "      var physics = best.getBehavior(\"Physics2\");",
        "      if (physics) {",
        "        physics.setStatic();",
        "      }",
        "      best.setOpacity(255);",
        "    }",
        "  };",
        "",
        "  AB.onWordCorrect = function (runtimeScene, slotIndex) {",
        "    AB.solvedSlots[slotIndex] = true;",
        "    AB.score += 20;",
        "    AB.lockBlock(runtimeScene, slotIndex);",
        "",
        "    var tiles = runtimeScene.getObjects(\"VerseTile\");",
        "    for (var t = 0; t < tiles.length; t++) {",
        "      if (tiles[t].getVariables().get(\"CurrentSlot\").getAsNumber() === slotIndex) {",
        "        tiles[t].removeBehavior(\"Draggable\");",
        "        break;",
        "      }",
        "    }",
        "",
        "    AB.playCorrectPop();",
        "    AB.flash(255, 255, 255, 120);",
        "    AB.updateHud(runtimeScene);",
        "",
        "    var allSolved = AB.solvedSlots.every(function (solved) {",
        "      return solved;",
        "    });",
        "    if (allSolved) {",
        "      AB.levelSolved = true;",
        "      AB.solvedTimer = 0;",
        "      AB.score += 50;",
        "      AB.playLevelComplete();",
        "      AB.shake(300);",
        "      AB.flash(255, 240, 180, 300);",
        "      AB.updateHud(runtimeScene);",
        "    }",
        "  };",
        "",
        "  var jsonManager = runtimeScene.getGame().getJsonManager();",
        "  var cachedScriptures = jsonManager.getLoadedJson(\"scriptures.json\");",
        "  if (cachedScriptures) {",
        "    AB.scripturesData = cachedScriptures;",
        "    AB.totalLevels = cachedScriptures.levels.length;",
        "    AB.startLevel(runtimeScene, AB.currentLevel);",
        "  } else {",
        "    jsonManager.loadJson(\"scriptures.json\", function (error, content) {",
        "      if (error || !content) {",
        "        console.error(\"AutoBuilder: failed to load scriptures.json\", error);",
        "        return;",
        "      }",
        "      AB.scripturesData = content;",
        "      AB.totalLevels = content.levels.length;",
        "      AB.startLevel(runtimeScene, AB.currentLevel);",
        "    });",
        "  }",
        "}",
        "",
        "var deltaSeconds = runtimeScene.getTimeManager().getElapsedTime() / 1000;",
        "",
        "if (AB.flashRemaining > 0) {",
        "  runtimeScene.setBackgroundColor(AB.flashColor.r, AB.flashColor.g, AB.flashColor.b);",
        "  AB.flashRemaining -= deltaSeconds * 1000;",
        "  if (AB.flashRemaining <= 0) {",
        "    runtimeScene.setBackgroundColor(AB.ambientColor.r, AB.ambientColor.g, AB.ambientColor.b);",
        "  }",
        "}",
        "",
        "if (AB.shakeRemaining > 0) {",
        "  var shakeLayer = runtimeScene.getLayer(\"\");",
        "  shakeLayer.setCameraX((Math.random() - 0.5) * 8);",
        "  shakeLayer.setCameraY((Math.random() - 0.5) * 8);",
        "  AB.shakeRemaining -= deltaSeconds * 1000;",
        "  if (AB.shakeRemaining <= 0) {",
        "    shakeLayer.setCameraX(0);",
        "    shakeLayer.setCameraY(0);",
        "  }",
        "}",
        "",
        "var inputManager = runtimeScene.getGame().getInputManager();",
        "var mouseDown = inputManager.isMouseButtonPressed(0);",
        "var touchStarted = inputManager.getStartedTouchIdentifiers().length > 0;",
        "var justPressed = (mouseDown && !AB._prevMouseDown) || touchStarted;",
        "AB._prevMouseDown = mouseDown;",
        "",
        "if (AB.gameComplete) {",
        "  if (justPressed) {",
        "    AB.resetGame(runtimeScene);",
        "  }",
        "} else if (AB.scripturesData) {",
        "  if (!AB.levelSolved) {",
        "    var tiles = runtimeScene.getObjects(\"VerseTile\");",
        "    tiles.forEach(function (tile) {",
        "      var draggable = tile.getBehavior(\"Draggable\");",
        "      if (draggable && draggable.wasJustDropped()) {",
        "        var bestIndex = 0;",
        "        var bestDist = Infinity;",
        "        for (var i = 0; i < AB.slotXs.length; i++) {",
        "          var dist = Math.abs(tile.getX() - AB.slotXs[i]);",
        "          if (dist < bestDist) {",
        "            bestDist = dist;",
        "            bestIndex = i;",
        "          }",
        "        }",
        "        tile.setPosition(AB.slotXs[bestIndex], AB.groundY + 40);",
        "        tile.getVariables().get(\"CurrentSlot\").setNumber(bestIndex);",
        "",
        "        if (",
        "          !AB.solvedSlots[bestIndex] &&",
        "          tile.getVariables().get(\"TileID\").getAsNumber() === bestIndex + 1",
        "        ) {",
        "          AB.onWordCorrect(runtimeScene, bestIndex);",
        "        }",
        "      }",
        "    });",
        "",
        "    AB.windTimer += deltaSeconds;",
        "    if (AB.windTimer > 2.5) {",
        "      AB.windTimer = 0;",
        "      runtimeScene.getObjects(\"StoneBlock\").forEach(function (block) {",
        "        var physics = block.getBehavior(\"Physics2\");",
        "        if (physics && !physics.isStatic()) {",
        "          var fx = (Math.random() * 2 - 1) * 120;",
        "          physics.applyForce(fx, -40, block.getCenterXInScene(), block.getCenterYInScene());",
        "        }",
        "      });",
        "    }",
        "",
        "    AB.levelTimeRemaining -= deltaSeconds;",
        "    if (AB.levelTimeRemaining <= 0) {",
        "      AB.levelTimeRemaining = AB.levelTimeLimit;",
        "      AB.score = Math.max(0, AB.score - 10);",
        "      AB.playTimeWarning();",
        "      AB.flash(220, 60, 60, 200);",
        "",
        "      var openSlots = [];",
        "      for (var s2 = 0; s2 < AB.solvedSlots.length; s2++) {",
        "        if (!AB.solvedSlots[s2]) {",
        "          openSlots.push(s2);",
        "        }",
        "      }",
        "      for (var m = openSlots.length - 1; m > 0; m--) {",
        "        var n = Math.floor(Math.random() * (m + 1));",
        "        var tmpSlot = openSlots[m];",
        "        openSlots[m] = openSlots[n];",
        "        openSlots[n] = tmpSlot;",
        "      }",
        "",
        "      var unsolvedTiles = runtimeScene.getObjects(\"VerseTile\").filter(function (tile) {",
        "        var slot = tile.getVariables().get(\"CurrentSlot\").getAsNumber();",
        "        return !AB.solvedSlots[slot];",
        "      });",
        "      unsolvedTiles.forEach(function (tile, idx) {",
        "        if (idx < openSlots.length) {",
        "          var newSlot = openSlots[idx];",
        "          tile.setPosition(AB.slotXs[newSlot], AB.groundY + 40);",
        "          tile.getVariables().get(\"CurrentSlot\").setNumber(newSlot);",
        "        }",
        "      });",
        "    }",
        "",
        "    AB.updateHud(runtimeScene);",
        "  } else {",
        "    AB.solvedTimer += deltaSeconds;",
        "    if (AB.solvedTimer > 1.4) {",
        "      AB.currentLevel += 1;",
        "      AB.startLevel(runtimeScene, AB.currentLevel);",
        "    }",
        "  }",
        "}"
      ],
